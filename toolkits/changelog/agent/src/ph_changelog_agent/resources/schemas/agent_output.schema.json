{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local changelog agent output",
  "oneOf": [
    {
      "type": "object",
      "required": ["status", "entries"],
      "properties": {
        "status": {"const": "ok"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["section", "text", "fact_ids"],
            "properties": {
              "section": {"type": "string"},
              "text": {"type": "string", "minLength": 1},
              "fact_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {"const": "needs_supervisor"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  ]
}
